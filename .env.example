# 로컬 개발용 환경변수 템플릿. 복사해서 사용: cp .env.example .env
# 모든 값은 선택이며, 비우면 app/core/config.py의 기본값으로 동작한다.
# 필드명 대문자 스네이크가 환경변수 이름 (예: aws_region → AWS_REGION).
# AWS 자격증명은 여기가 아니라 ~/.aws (aws configure)가 담당한다.

# 인증. 로컬 백엔드 토큰(kid=ephemeral)은 prod JWKS로 검증되지 않으므로 그 공개키 PEM을 직접 주입 (줄바꿈은 \n으로)
# 비우면 prod JWKS(https://api.fitset.kro.kr/.well-known/jwks.json)로 검증한다
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 백엔드 내부 API. 로컬 스프링 주소가 다르면 변경
# SPRING_INTERNAL_BASE_URL=http://localhost:8080/internal

# 부팅 시 routines Scan 건수 제한. 전량 로드(~350MB)가 부담스러운 개발 환경용
# ROUTINES_SCAN_LIMIT=1000

# LLM 롤백. Nova 2 Lite 품질 문제 시 Haiku 4.5로 즉시 전환 (CLAUDE.md)
# LLM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS_REGION=ap-northeast-2
