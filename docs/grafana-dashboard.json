{
  "title": "FitSet AI Server",
  "uid": "fitset-ai-server",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "데이터소스"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=\"fitset-ai-server\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "label": "인스턴스"
      }
    ]
  },
  "panels": [
    {
      "type": "stat", "title": "가동 시간",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [{ "expr": "time() - process_start_time_seconds{job=\"fitset-ai-server\", instance=~\"$instance\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "type": "stat", "title": "요청량 (5분 rate)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m]))", "legendFormat": "req/s" }]
    },
    {
      "type": "stat", "title": "5xx 에러율",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        }, "overrides": []
      },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"fitset-ai-server\", instance=~\"$instance\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m]))", "legendFormat": "5xx 비율" }]
    },
    {
      "type": "stat", "title": "p95 응답시간 (전체)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m])))", "legendFormat": "p95" }]
    },
    {
      "type": "timeseries", "title": "엔드포인트별 요청량",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum by (handler) (rate(http_requests_total{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m]))", "legendFormat": "{{handler}}" }]
    },
    {
      "type": "timeseries", "title": "엔드포인트별 p95 응답시간",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (handler, le) (rate(http_request_duration_seconds_bucket{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m])))", "legendFormat": "{{handler}}" }]
    },
    {
      "type": "timeseries", "title": "상태코드별 요청량",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum by (status) (rate(http_requests_total{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "프로세스 CPU · 메모리",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "메모리(RSS)" },
            "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.axisPlacement", "value": "right" } ]
          }
        ]
      },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=\"fitset-ai-server\", instance=~\"$instance\"}[5m])", "legendFormat": "CPU" },
        { "expr": "process_resident_memory_bytes{job=\"fitset-ai-server\", instance=~\"$instance\"}", "legendFormat": "메모리(RSS)" }
      ]
    },
    {
      "type": "timeseries", "title": "수집 상태 (up)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [{ "expr": "up{job=\"fitset-ai-server\", instance=~\"$instance\"}", "legendFormat": "{{instance}}" }]
    }
  ]
}
