{
  "family": "fitset-ai-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::729743892772:role/fitset-ai-execution-role",
  "taskRoleArn": "arn:aws:iam::729743892772:role/fitset-ai-task-role",
  "containerDefinitions": [
    {
      "name": "fitset-ai-server",
      "image": "729743892772.dkr.ecr.ap-northeast-2.amazonaws.com/fitset-ai-server:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp", "appProtocol": "http" }
      ],
      "environment": [
        { "name": "SPRING_INTERNAL_BASE_URL", "value": "https://api.fitset.kro.kr/internal" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fitset-ai-server",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
