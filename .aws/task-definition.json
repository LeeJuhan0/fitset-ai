{
  "family": "fitset-ai-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::729743892772:role/fitset-ai-execution-role",
  "taskRoleArn": "arn:aws:iam::729743892772:role/fitset-ai-task-role",
  "containerDefinitions": [
    {
      "name": "fitset-ai-server",
      "image": "729743892772.dkr.ecr.ap-northeast-2.amazonaws.com/fitset-ai-server:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp", "appProtocol": "http" }
      ],
      "environment": [
        { "name": "MYSQL_HOST", "value": "hangang-rds.c9uc6woykoqt.ap-northeast-2.rds.amazonaws.com" }
      ],
      "secrets": [
        { "name": "MYSQL_PASSWORD", "valueFrom": "arn:aws:ssm:ap-northeast-2:729743892772:parameter/fitset/prod/ai/mysql-password" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fitset-ai-server",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "alloy",
      "image": "729743892772.dkr.ecr.ap-northeast-2.amazonaws.com/fitset-ai-alloy:latest",
      "essential": false,
      "memory": 256,
      "secrets": [
        { "name": "GRAFANA_PROM_URL", "valueFrom": "arn:aws:ssm:ap-northeast-2:729743892772:parameter/fitset/prod/grafana/prom-url" },
        { "name": "GRAFANA_PROM_USER", "valueFrom": "arn:aws:ssm:ap-northeast-2:729743892772:parameter/fitset/prod/grafana/prom-user" },
        { "name": "GRAFANA_API_TOKEN", "valueFrom": "arn:aws:ssm:ap-northeast-2:729743892772:parameter/fitset/prod/grafana/api-token" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fitset-ai-server",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "alloy"
        }
      }
    }
  ]
}
